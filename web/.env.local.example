# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Qdrant ──────────────────────────────────────────────────
# Cloud: https://cloud.qdrant.io  →  Cluster URL + API key
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-api-key-here

# Local Docker: http://localhost:6333  (leave QDRANT_API_KEY empty)
# QDRANT_URL=http://localhost:6333

# ── Collection name (optional, default: knowledge_base) ──────
QDRANT_COLLECTION=knowledge_base
